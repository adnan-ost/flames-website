# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dish photography lives in Sanity's image CDN, not in git.
# These local masters are a development convenience only; the Sanity seed
# script reads its originals from the previous repo's assets folder.
/public/menu-items

# Local reference material — competitor menu scans, extraction dumps. Never shipped.
.reference/

# Vendored agent tooling, not part of the website. Reinstall with:
#   npx skills add sanity-io/agent-toolkit --skill sanity-best-practices -y
/.agents/
/skills-lock.json
/.claude/skills/sanity-best-practices
# Skills written for this project ARE committed — see .claude/skills/cpanel.
# Note: git cannot re-include a path inside an ignored directory, which is why
# /.claude/ is not ignored wholesale.
