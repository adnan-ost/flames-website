# /etc/nginx/conf.d/flames.conf
#
# Next is not exposed directly; nginx handles TLS, slow-loris and payload
# limits, which the Next.js self-hosting guide recommends.

server {
  listen 80;
  server_name flamesbytheindus.com www.flamesbytheindus.com;
  return 301 https://flamesbytheindus.com$request_uri;
}

server {
  listen 443 ssl http2;
  server_name www.flamesbytheindus.com;
  # certbot fills these in
  return 301 https://flamesbytheindus.com$request_uri;
}

server {
  listen 443 ssl http2;
  # `listen ... http2` is deprecated from nginx 1.25.1; the replacement is a
  # separate `http2 on;` line, which older nginx rejects as an unknown
  # directive. Check `nginx -v` on the box before modernising this.
  server_name flamesbytheindus.com;

  # ssl_certificate     /etc/letsencrypt/live/flamesbytheindus.com/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/flamesbytheindus.com/privkey.pem;

  # Security headers. `always` so error responses carry them too.
  # HSTS only after certbot has run — with no valid cert it locks visitors out
  # for six months. frame-ancestors 'self' rather than 'none' because Sanity's
  # Presentation mode iframes the site from /studio, which is the same origin.
  add_header Strict-Transport-Security "max-age=15768000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Content-Security-Policy "frame-ancestors 'self'" always;

  # Next fingerprints these filenames, so they are safe to cache hard.
  location /_next/static/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_cache_valid 200 1y;
    # nginx gotcha: a location with any add_header of its own drops ALL
    # inherited add_header lines, so the security headers must be repeated
    # here alongside Cache-Control.
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header Strict-Transport-Security "max-age=15768000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
  }

  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        "upgrade";
    # Do not buffer: it defeats streaming and Suspense.
    proxy_buffering off;
    proxy_read_timeout 300s;
  }
}

# menu.flamesbytheindus.com is being removed entirely (see AGENTS.md), so it is
# deliberately absent here. Any printed QR code pointing at it will stop
# resolving.
