# Sanity — copy to .env.local and fill in.
# Create the project at https://sanity.io/manage (or `npx sanity@latest init`).

# Public: safe to expose, they end up in the browser bundle.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Secret: server-only. Needed by `npm run sanity:seed`, never by the site.
# Sanity Manage → API → Tokens → new token with Editor rights.
SANITY_API_WRITE_TOKEN=
